# ============================================================
# codeup-ai-reviewer 配置样例
# 复制成 .env 后填值。所有尖括号 <> 的地方都必须换成你自己的。
# ============================================================

# ---------- 云效 ----------
# 个人访问令牌。云效 → 个人设置 → 个人访问令牌
# 需要勾的权限：代码管理（仓库读 / 合并请求读写 / 提交读写）
CODEUP_TOKEN=<YOUR_CODEUP_TOKEN>

# 组织 ID。云效地址栏里 /o/<这一段>/ 或者用 API 查
CODEUP_ORG_ID=<YOUR_ORG_ID>

# 云效 OpenAPI 域名。公有云一般不用改
CODEUP_DOMAIN=https://openapi-rdc.aliyuncs.com

# 要评审的仓库，格式 id=gitUrl，多个用逗号分隔。
# id 是 repositoryId（数字），不是 projectId —— 这两个不一样，用错会 404/500
CODEUP_REPOS=<REPO_ID_1>=https://codeup.aliyun.com/<ORG>/<GROUP>/<REPO_1>.git,<REPO_ID_2>=https://codeup.aliyun.com/<ORG>/<GROUP>/<REPO_2>.git

# git 拉代码用的用户名。用访问令牌走 HTTPS 时填 oauth2 即可
CODEUP_GIT_USER=oauth2

# ---------- 模型 ----------
# 任何 OpenAI 兼容接口都能用：官方 API、自建 vLLM、云厂商托管
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 单次输出预算。推理型模型会吃掉一部分，给小了会出现 JSON 断在半路
# 实测合法范围 [1, 393216]，给 131072 基本不会成为限制
LLM_MAX_TOKENS=131072
LLM_TEMPERATURE=0.2

# ---------- 分批 ----------
# 每批 diff 上限（字符）。
# ⚠️ 反直觉：这个值决定"分几批"，不决定"能看多少"。
#    实测真实代码约 4.3 字符/token，240 万字符输入仍能通过。
#    调小不会更安全，只会把文件切碎、让模型看到半个文件、更容易误判。
MAX_DIFF_CHARS=400000
BATCH_REVIEW=1
MAX_BATCHES=8
# 单批输出超限时最多对半拆几层（3 = 最多裂成 8 个子批）
MAX_SPLIT_DEPTH=3

# ---------- 全局通道（越权/事务/契约/并发）----------
# 这四类靠 diff 判不了，必须读横切文件的全文
GLOBAL_REVIEW=1
CROSS_MAX_FILES=20
CROSS_MAX_CHARS=120000
# 什么算"横切文件"：鉴权 filter、拦截器、事务配置、公共上下文
CROSS_PATTERNS=(?i)(filter|interceptor|security|auth|transaction|config|common|aspect)
# ⚠️ 故意只读源码，不读 yml/properties：
#    配置文件里常有数据库口令、第三方密钥，送进公网模型是另一类风险。
#    确有需要再显式放开，例如 <EXT>,<EXT>,yml
CROSS_EXTS=java,kt

# ---------- 评论与通知 ----------
# 云效评论正文硬上限 65535 字符，超出整条发不出去，这里留余量并自动分条
COMMENT_MAX_CHARS=60000
# 是否额外发"行内评论"（需要 patchset 信息，可能失败，失败不影响整体评论）
POST_INLINE=0
INLINE_LIMIT=5

# ---------- 提交状态回写（云效「自动化检查」里那个勾）----------
# 不开流水线、不装 Runner、不加 .workflow/，评审完主动 POST 一次：
#   /oapi/v1/codeup/organizations/{org}/repositories/{repo}/commits/{sha}/statuses
# 云效就会把它渲染成「自动化检查」里的一个三方状态。
# ⚠️ 云效不校验我们真跑了什么 —— 这个勾可不可信，完全靠我们自己保证。
COMMIT_STATUS=1
# 检查项名字，就是界面上显示的那个（改了它，云效里显示的就是新名字）
CHECK_CONTEXT=ai-bug-scan

# 忽略的文件，避免把二进制/压缩产物送去评审
IGNORE_PATH_PATTERNS=*.png,*.jpg,*.jpeg,*.gif,*.ico,*.bmp,*.woff,*.woff2,*.ttf,*.eot,*.min.js,*.min.css,*.lock,package-lock.json

# ---------- 运行时 ----------
# webhook 入口自己的校验头，防止公网裸奔被随便打
WEBHOOK_TOKEN=<YOUR_WEBHOOK_TOKEN>
POLL_INTERVAL=180
HTTP_TIMEOUT=60
DRY_RUN=1
REPO_DIR=./work/repo
STATE_FILE=./work/state.json
